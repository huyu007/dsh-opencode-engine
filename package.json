{
  "name": "dsh-opencode-engine",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that plugs the opencode coding engine in as an out-of-process subagent: an ACP provider driving `opencode acp`, the /opencode command with real session/load continuation, a fail-closed approval bridge, and classified failure receipts.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyu007/dsh-opencode-engine.git"
  },
  "bugs": {
    "url": "https://github.com/huyu007/dsh-opencode-engine/issues"
  },
  "homepage": "https://github.com/huyu007/dsh-opencode-engine#readme",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "opencode",
    "acp",
    "agent-client-protocol",
    "subagent",
    "coding-agent"
  ],
  "icon": "./icon.svg"
}
